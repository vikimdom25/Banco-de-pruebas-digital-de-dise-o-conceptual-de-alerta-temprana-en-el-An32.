# Cálculo dinámico del umbral de stall basado en Flaps (Fuente: an32.xml)
# Retorna el ángulo de ataque donde el ala deja de sustentar.
var get_stall_threshold = func() {
    var flaps_norm = getprop("/controls/flight/flaps");
    if (flaps_norm == nil) flaps_norm = 0.0;
    
    # Ecuación Lineal Validada:
    # Flaps 0 (Limpio) -> 16.0 grados
    # Flaps 1 (Full)   -> 13.0 grados
    # La interpolación cubre cualquier posición intermedia.
    var threshold = 16.0 - (3.0 * flaps_norm);
    
    return threshold;
};

var last_alpha_mem = 0.0;
var last_gload_mem = 1.0;
var divergencia_start_time = nil; 
var metadata_stall_state = 0;
var metadata_stall_start = nil;
var metadata_stall_duration = 0.0;

var detect_physics_stall = func(curr_alpha, curr_gload) {
    
    # 1. Filtro de seguridad:
    # Bajo 8 grados es físicamente imposible tener stall en este avión.
    if (curr_alpha < 8.0) {
        last_alpha_mem = curr_alpha;
        last_gload_mem = curr_gload;
        divergencia_start_time = nil; 
        metadata_stall_state = 0;
        return 0; 
    }

    # 2. Calcular Deltas y Límite Actual
    var d_alpha = curr_alpha - last_alpha_mem;
    var d_gload = curr_gload - last_gload_mem;
    var stall_aoa_limit = get_stall_threshold(); 
    
    last_alpha_mem = curr_alpha;
    last_gload_mem = curr_gload;

    # 3. EVALUACIÓN DE CONDICIONES (Lógica Híbrida)
    var stall_detected = 0;
    
    # CASO A: Stall Dinámico (Entrada Violenta)
    # Útil para detectar el inicio brusco antes de cruzar el umbral estático.
    # Nariz subiendo rápido (d_alpha > 0) + Pérdida de sustentación (d_gload < 0)
    if (d_alpha > 0.005 and d_gload < -0.01) {
        stall_detected = 1;
    }
    
    # CASO B: Stall Estático (Estado Crítico) - EL MÁS ROBUSTO
    # Si el Alpha supera el límite aerodinámico del ala, ES STALL.
    # Esto captura Barrenas Planas (Alpha 90), Espirales (Alpha 25) y Oscilaciones (Alpha 15).
    if (curr_alpha > stall_aoa_limit) {
        stall_detected = 1;
    }
    
    # CASO C: Stall Acelerado (Carga G Alta)
    # Si estamos tirando Gs (>1.5) y el Alpha está cerca del límite (margen 2 grados),
    # es muy peligroso y se considera inicio de pérdida acelerada.
    if (curr_gload > 1.5 and curr_alpha > (stall_aoa_limit - 2.0)) {
        stall_detected = 1;
    }

    # 4. GESTIÓN DEL TIEMPO (Confirmación y Persistencia)
    if (stall_detected == 1) {
        if (divergencia_start_time == nil) divergencia_start_time = systime();
        
        var duracion = systime() - divergencia_start_time;
        
        # Log de diagnóstico (limitado a cada 1s para limpieza)
        if (debug_enabled and math.mod(systime(), 1.0) < 0.05) {
             print("[FISICA] STALL ACTIVO. Alpha:", sprintf("%.1f", curr_alpha), 
                   " Limite:", sprintf("%.1f", stall_aoa_limit), 
                   " G:", sprintf("%.1f", curr_gload));
        }

        # Tiempo de confirmación reducido para mayor sensibilidad
        if (duracion >= 0.25) { 
            metadata_stall_state = 2; 
            return 1; 
        }
    } else {
        # Histéresis de seguridad:
        # Si acabamos de salir de un stall, esperamos 1 segundo antes de borrar el estado
        # para evitar parpadeos si el Alpha oscila justo en el límite.
        if (divergencia_start_time != nil and (systime() - divergencia_start_time) < 1.0) {
             # Mantenemos el estado de alerta un poco más
             return 0; 
        }
        
        divergencia_start_time = nil;
        metadata_stall_state = 0;
    }

    return 0;
}

